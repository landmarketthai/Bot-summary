# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to the browser. Used by the webhook handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── LINE Messaging API ───────────────────────────────────────────────────────
# Found in: LINE Developers console → your channel → Basic settings
LINE_CHANNEL_SECRET=your-channel-secret-here

# Optional: needed only if you send reply/push messages
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token-here

# Comma/space-separated LINE group IDs allowed to use P2A Physical Inventory.
# Set to an empty value to disable Physical Inventory routing.
PHYSICAL_INVENTORY_LINE_GROUP_IDS=C1d96954d298d99f65912a5f1e96edffc

# ─── P2C Purchase Capture ─────────────────────────────────────────────────────
# Both gates are fail-closed and BOTH must pass before a single LINE message is
# routed to purchase capture. Leaving either unset keeps the feature dormant.
#
# 1. The feature flag. Only the exact string "true" enables it.
PURCHASE_CAPTURE_WEBHOOK_ENABLED=
# 2. The LINE source allowlist — comma/space separated group/room/user IDs.
#    Unlike PHYSICAL_INVENTORY_LINE_GROUP_IDS this has NO default: purchase
#    capture writes stock into the MAIN warehouse, so the permitted sources are
#    always an explicit Production decision. Empty means no source is allowed.
#    Start with a dedicated UAT group only; never a live market group.
PURCHASE_CAPTURE_LINE_GROUP_IDS=
# Fail-closed gate for the purchase capture finalization/recovery cron route.
# Checked after CRON_SECRET auth, so it is never an auth bypass.
PURCHASE_CAPTURE_CRON_ENABLED=

# OpenAI API — used by slip extraction and the read-only @Botsummary analyst
OPENAI_API_KEY=your-openai-api-key-here
SLIP_EXTRACTION_MODEL=gpt-6-luna
# Fail-closed feature gate. Enable only after UAT.
BOT_SUMMARY_ANALYST_ENABLED=
# Comma/space-separated LINE group/room/user source IDs allowed to query business data.
# Empty means @Botsummary is unavailable everywhere even when the feature flag is true.
BOT_SUMMARY_ANALYST_LINE_SOURCE_IDS=
BOT_SUMMARY_ANALYST_MODEL=gpt-6-luna

# Protected cron routes, including the external Release B produce finalizer.
# Release B does not create a scheduler; configure a durable caller separately.
CRON_SECRET=your-random-cron-secret

# P1 Daily Sales report recipients — comma/space separated LINE target IDs.
# Configured independently from the Stock report on purpose: the two reports
# must be able to go to different people. While it is unset the scheduled sales
# route logs and sends nothing, which is how delivery stays inactive until
# Production activation is approved.
SALES_SUMMARY_LINE_TARGETS=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: debug | info | warn | error  (default: debug in dev, info in prod)
LOG_LEVEL=info
